{
  "name": "messenger-app",
  "version": "1.0.0",
  "private": true,
  "description": "Modern, scalable messaging app for mobile and web",
  "workspaces": ["backend", "frontend", "shared"],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:studio": "npm run db:studio -w backend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "test": "npm run test -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
